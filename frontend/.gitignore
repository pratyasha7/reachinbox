# ==========================================
# 1. Dependencies
# ==========================================
node_modules/
backend/node_modules/
frontend/node_modules/
.pnp
.pnp.js

# ==========================================
# 2. Secret Environment Files (Never Commit!)
# ==========================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
frontend/.env.local
*.env

# Keep template examples visible for reviewers
!.env.example
!backend/.env.example
!frontend/.env.example

# ==========================================
# 3. Build & Compiler Artifacts
# ==========================================
# Next.js build cache & static export
frontend/.next/
frontend/out/
.next/
out/

# TypeScript compilation output
backend/dist/
dist/
build/
*.tsbuildinfo

# ==========================================
# 4. Database & Docker Volume Data
# ==========================================
pgdata/
redisdata/
esdata/
*.rdb
*.aof

# ==========================================
# 5. Logs & System Junk
# ==========================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.DS_Store
Thumbs.db

# ==========================================
# 6. IDE & Editor Configs
# ==========================================
.vscode/
.idea/
*.swp
*.swo

# ==========================================
